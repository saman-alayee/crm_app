# Local (no Docker): SQLite
DATABASE_URL="file:./prisma/dev.db"
# Production PostgreSQL example:
# DATABASE_URL=postgresql://hr:hr_secret@localhost:5432/hr_system?schema=public


# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# API
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption for bank IBAN at rest (32-byte hex = 64 chars)
BANK_DATA_ENCRYPTION_KEY=

# Telegram bot (Telegraf polling)
# 1) Create bot via @BotFather → paste token here
# 2) Run API then: npm run bot:install && npm run dev:bot
# 3) Open bot in Telegram → /start → login with panel username/password
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
BOT_INTERNAL_API_KEY=change-me-bot-internal-key
# Optional override if API is not on localhost:4000
# BOT_API_BASE=http://127.0.0.1:4000/api/v1

# Seed owner
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=ChangeMeOwner123!
SEED_OWNER_EMAIL=owner@example.com

# Audit log retention (auto-purge job in API)
# Keep logs for N days (default 90). Set 0 to disable age purge.
AUDIT_RETENTION_DAYS=90
# Hard cap on number of rows (default 100000). Set 0 to disable.
AUDIT_MAX_ROWS=100000
# How often purge runs, in hours (default 24)
AUDIT_PURGE_INTERVAL_HOURS=24

# Dashboard
NUXT_PUBLIC_API_BASE=http://localhost:4000/api/v1
