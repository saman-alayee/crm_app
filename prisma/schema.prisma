generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  // Local default: SQLite (no Docker). For production use postgresql + DATABASE_URL.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum LeaveType {
  HOURLY
  DAILY
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SalaryRequestType {
  SALARY
  ADVANCE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskScheduleKind {
  ONCE
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

enum PermissionEffect {
  GRANT
  DENY
}

enum NotificationChannel {
  DASHBOARD
  TELEGRAM
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// ─── Auth & Users ────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  username     String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  tokenVersion Int       @default(0) // bump to invalidate all access tokens
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee          Employee?
  userRoles         UserRole[]
  userPermissions   UserPermission[]
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  auditLogs         AuditLog[]          @relation("AuditActor")
  createdTasks      Task[]              @relation("TaskCreator")
  approvedLeaves    LeaveRequest[]      @relation("LeaveApprover")
  approvedSalaries  SalaryRequest[]     @relation("SalaryApprover")
  announcements     Announcement[]      @relation("AnnouncementAuthor")
  authoredNotes     EmployeeNote[]      @relation("NoteAuthor")
  createdContacts   Contact[]           @relation("ContactCreator")
  createdTrades     TradeRequest[]      @relation("TradeCreator")
  createdInventory  InventoryItem[]     @relation("InventoryCreator")
  createdShareLinks ShareLink[]         @relation("ShareLinkCreator")
  moneyRequests     MoneyRequest[]      @relation("MoneyRequester")
  reviewedMoney     MoneyRequest[]      @relation("MoneyReviewer")
  editHistories     RequestEditHistory[] @relation("EditAuthor")
  opsLimitLogs      OpsLimitChangeLog[] @relation("OpsLimitActor")

  @@index([isActive])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Employee {
  id             String    @id @default(cuid())
  userId         String    @unique
  employeeCode   String?   @unique
  firstName      String
  lastName       String
  phone          String?
  department     String?
  jobTitle       String?
  hireDate       DateTime?
  telegramUserId String?   @unique
  telegramUsername String?
  profileNote    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveRequests  LeaveRequest[]
  salaryRequests SalaryRequest[]
  bankAccounts   BankAccount[]
  assignedTasks  Task[]          @relation("TaskAssignee")
  notes          EmployeeNote[]

  @@index([telegramUserId])
  @@index([lastName, firstName])
  @@map("employees")
}

// ─── RBAC ────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false) // Owner etc. — protected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  module      String
  action      String
  key         String   @unique // e.g. leave.approve
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserPermission {
  userId       String
  permissionId String
  effect       PermissionEffect @default(GRANT)
  createdAt    DateTime         @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

// ─── Leave ───────────────────────────────────────────────

model LeaveRequest {
  id              String        @id @default(cuid())
  employeeId      String
  type            LeaveType
  leaveDate       DateTime
  startTime       String? // HH:mm for HOURLY
  endTime         String?
  reason          String?
  status          RequestStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("LeaveApprover", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([status, createdAt])
  @@index([leaveDate])
  @@map("leave_requests")
}

// ─── Salary / Advance ────────────────────────────────────

model SalaryRequest {
  id              String            @id @default(cuid())
  employeeId      String
  type            SalaryRequestType
  amount          Decimal
  description     String?
  status          RequestStatus     @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("SalaryApprover", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([status, createdAt])
  @@map("salary_requests")
}

// ─── Bank ────────────────────────────────────────────────

model BankAccount {
  id            String   @id @default(cuid())
  employeeId    String
  accountHolder String
  accountNumber String? // store encrypted or masked at rest via app layer
  iban          String // IR... encrypted at app layer when configured
  bankName      String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  history  BankAccountHistory[]

  @@index([employeeId])
  @@map("bank_accounts")
}

model BankAccountHistory {
  id            String   @id @default(cuid())
  bankAccountId String
  changedById   String?
  previousValue Json
  newValue      Json
  createdAt     DateTime @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([bankAccountId, createdAt])
  @@map("bank_account_history")
}

// ─── Tasks ───────────────────────────────────────────────

model Task {
  id                String           @id @default(cuid())
  title             String
  description       String?
  priority          TaskPriority     @default(MEDIUM)
  status            TaskStatus       @default(PENDING)
  dueAt             DateTime?
  scheduleKind      TaskScheduleKind @default(ONCE)
  scheduleActive    Boolean          @default(true)
  nextReminderAt    DateTime?
  creatorId         String
  assigneeId        String
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  creator   User                    @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee  Employee                @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  history   TaskAssignmentHistory[]

  @@index([assigneeId, status])
  @@index([status, dueAt])
  @@index([nextReminderAt])
  @@map("tasks")
}

model TaskAssignmentHistory {
  id           String   @id @default(cuid())
  taskId       String
  fromEmployee String?
  toEmployee   String
  changedById  String?
  note         String?
  createdAt    DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_assignment_history")
}

// ─── Notifications ───────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  eventType String
  entityType String?
  entityId  String?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime @default(now())

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, isRead, createdAt])
  @@index([eventType, entityId])
  @@map("notifications")
}

model NotificationDelivery {
  id              String              @id @default(cuid())
  notificationId  String
  channel         NotificationChannel
  status          DeliveryStatus      @default(PENDING)
  idempotencyKey  String              @unique
  attempts        Int                 @default(0)
  lastError       String?
  nextAttemptAt   DateTime            @default(now())
  sentAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

model OutboxEvent {
  id          String       @id @default(cuid())
  eventType   String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  availableAt DateTime     @default(now())
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, availableAt])
  @@map("outbox_events")
}

// ─── Audit & Settings ────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  module     String
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([module, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("system_settings")
}

// ─── CRM extras ──────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("departments")
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  audience    String    @default("ALL") // ALL | ROLE | ACTIVE_EMPLOYEES
  roleId      String?
  createdById String
  isPinned    Boolean   @default(false)
  publishAt   DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([publishAt, expiresAt])
  @@map("announcements")
}

model EmployeeNote {
  id         String   @id @default(cuid())
  employeeId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  author   User     @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
  @@map("employee_notes")
}

// ─── Shop CRM ────────────────────────────────────────────

enum ProductKind {
  PHONE
  SIM
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  MATCHED
  CLOSED
  CANCELLED
}

enum MatchKind {
  BUY_SELL
  BUY_INVENTORY
}

enum MatchScore {
  EXACT
  SIMILAR
}

enum MoneyRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MoneyReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
}

model AcquisitionSource {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  trades   TradeRequest[]

  @@map("acquisition_sources")
}

model Contact {
  id                   String   @id @default(cuid())
  fullName             String
  mobile               String
  acquisitionSourceId  String?
  notes                String?
  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  acquisitionSource AcquisitionSource? @relation(fields: [acquisitionSourceId], references: [id], onDelete: SetNull)
  createdBy         User?              @relation("ContactCreator", fields: [createdById], references: [id], onDelete: SetNull)
  trades            TradeRequest[]

  @@unique([mobile])
  @@index([fullName])
  @@index([acquisitionSourceId])
  @@map("contacts")
}

model ProductOption {
  id        String      @id @default(cuid())
  kind      ProductKind
  category  String
  value     String
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([kind, category, value])
  @@index([kind, category, isActive])
  @@map("product_options")
}

model TradeRequest {
  id                  String      @id @default(cuid())
  side                TradeSide
  productKind         ProductKind
  status              TradeStatus @default(OPEN)
  contactId           String?
  customerName        String?
  customerMobile      String?
  acquisitionSourceId String?
  specs               Json
  quantity            Int         @default(1)
  price               Decimal?
  note                String?
  createdById         String
  closedAt            DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  contact           Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  acquisitionSource AcquisitionSource? @relation(fields: [acquisitionSourceId], references: [id], onDelete: SetNull)
  createdBy         User               @relation("TradeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  matchesAsBuy      MatchSuggestion[]  @relation("MatchBuy")
  matchesAsSell     MatchSuggestion[]  @relation("MatchSell")

  @@index([side, status, productKind])
  @@index([status, createdAt])
  @@index([customerMobile])
  @@map("trade_requests")
}

model InventoryItem {
  id          String      @id @default(cuid())
  productKind ProductKind
  specs       Json
  quantity    Int         @default(1)
  costPrice   Decimal?
  sellPrice   Decimal?
  note        String?
  isActive    Boolean     @default(true)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  createdBy  User?              @relation("InventoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  matches    MatchSuggestion[]
  shareItems ShareLinkItem[]

  @@index([productKind, isActive])
  @@index([quantity])
  @@map("inventory_items")
}

model MatchSuggestion {
  id              String      @id @default(cuid())
  dedupeKey       String      @unique
  kind            MatchKind
  score           MatchScore
  buyRequestId    String?
  sellRequestId   String?
  inventoryItemId String?
  notifiedAt      DateTime?
  dismissedAt     DateTime?
  createdAt       DateTime    @default(now())

  buyRequest    TradeRequest?  @relation("MatchBuy", fields: [buyRequestId], references: [id], onDelete: Cascade)
  sellRequest   TradeRequest?  @relation("MatchSell", fields: [sellRequestId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([kind, createdAt])
  @@index([buyRequestId])
  @@map("match_suggestions")
}

model ShareLink {
  id          String    @id @default(cuid())
  token       String    @unique
  title       String?
  createdById String
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User            @relation("ShareLinkCreator", fields: [createdById], references: [id], onDelete: Cascade)
  items     ShareLinkItem[]
  events    ShareLinkEvent[]

  @@index([isActive, createdAt])
  @@map("share_links")
}

model ShareLinkItem {
  id              String @id @default(cuid())
  shareLinkId     String
  inventoryItemId String

  shareLink     ShareLink     @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([shareLinkId, inventoryItemId])
  @@map("share_link_items")
}

model ShareLinkEvent {
  id          String   @id @default(cuid())
  shareLinkId String
  eventType   String
  meta        Json?
  createdAt   DateTime @default(now())

  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([shareLinkId, createdAt])
  @@map("share_link_events")
}

model OpsBankAccount {
  id                String    @id @default(cuid())
  name              String
  bankName          String?
  accountNumber     String?
  iban              String?
  isActive          Boolean   @default(true)
  manualBalance     Decimal?
  balanceUpdatedAt  DateTime?
  dailyCapTotal     Decimal?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  methods       OpsPaymentMethod[]
  limitLogs     OpsLimitChangeLog[]
  moneyRequests MoneyRequest[]
  reservations  MoneyReservation[]

  @@index([isActive])
  @@map("ops_bank_accounts")
}

model OpsPaymentMethod {
  id               String   @id @default(cuid())
  opsBankAccountId String
  name             String
  dailyCap         Decimal?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  opsBankAccount OpsBankAccount     @relation(fields: [opsBankAccountId], references: [id], onDelete: Cascade)
  moneyRequests  MoneyRequest[]
  reservations   MoneyReservation[]

  @@index([opsBankAccountId, isActive])
  @@map("ops_payment_methods")
}

model OpsLimitChangeLog {
  id               String   @id @default(cuid())
  opsBankAccountId String
  changedById      String?
  before           Json
  after            Json
  createdAt        DateTime @default(now())

  opsBankAccount OpsBankAccount @relation(fields: [opsBankAccountId], references: [id], onDelete: Cascade)
  changedBy      User?          @relation("OpsLimitActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([opsBankAccountId, createdAt])
  @@map("ops_limit_change_logs")
}

model MoneyRequest {
  id               String             @id @default(cuid())
  opsBankAccountId String
  paymentMethodId  String?
  amount           Decimal
  purpose          String?
  status           MoneyRequestStatus @default(PENDING)
  requestedById    String
  reviewedById     String?
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  opsBankAccount OpsBankAccount      @relation(fields: [opsBankAccountId], references: [id], onDelete: Restrict)
  paymentMethod  OpsPaymentMethod?   @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  requestedBy    User                @relation("MoneyRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy     User?               @relation("MoneyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reservation    MoneyReservation?

  @@index([status, createdAt])
  @@index([opsBankAccountId, status])
  @@map("money_requests")
}

model MoneyReservation {
  id               String                  @id @default(cuid())
  moneyRequestId   String                  @unique
  opsBankAccountId String
  paymentMethodId  String?
  amount           Decimal
  status           MoneyReservationStatus  @default(RESERVED)
  dayKey           String
  createdAt        DateTime                @default(now())
  releasedAt       DateTime?
  consumedAt       DateTime?

  moneyRequest   MoneyRequest      @relation(fields: [moneyRequestId], references: [id], onDelete: Cascade)
  opsBankAccount OpsBankAccount    @relation(fields: [opsBankAccountId], references: [id], onDelete: Restrict)
  paymentMethod  OpsPaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([opsBankAccountId, dayKey, status])
  @@index([paymentMethodId, dayKey, status])
  @@map("money_reservations")
}

model RequestEditHistory {
  id         String    @id @default(cuid())
  entityType String
  entityId   String
  editedById String
  before     Json
  after      Json
  diffText   String
  sensitive  Boolean   @default(false)
  ackedAt    DateTime?
  ackedById  String?
  createdAt  DateTime  @default(now())

  editedBy User @relation("EditAuthor", fields: [editedById], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([sensitive, ackedAt])
  @@map("request_edit_histories")
}
